# =============================================================================
# UPTIME KUMA VIRTUAL HOST TEMPLATE (REGEX SUBS_FILTER)
# =============================================================================
# Hosts Uptime Kuma under '/uptime-kuma/' using regex-based path replacement.
# Requires 'ngx_http_subs_filter_module.so' loaded in modules.conf.
#
# Deployment:
#   - Replace 'uptime-regex.example' with your actual domain name.
#   - Replace 'uptime_kuma_regex' with a unique ACME identifier.
#   - Replace 'uptime_kuma_backend' with a unique upstream pool name.
#   - To embed into an existing virtual host, copy the upstream and locations.
# =============================================================================

upstream uptime_kuma_backend {
    zone uptime_kuma_backend 64k;
    server uptime-kuma:3001 resolve;
    keepalive 32;
}

acme_client uptime_kuma_regex https://acme-v02.api.letsencrypt.org/directory;

server {
    listen 80;
    server_name uptime-regex.example;

    acme uptime_kuma_regex;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name uptime-regex.example;

    acme uptime_kuma_regex;

    ssl_certificate $acme_cert_uptime_kuma_regex;
    ssl_certificate_key $acme_cert_key_uptime_kuma_regex;

    access_log /var/log/angie/domains/uptime-regex.example.log extended;
    error_log /var/log/angie/domains/uptime-regex.example.error.log error;

    if ($anti_replay = 307) { return 307 https://$host$request_uri; }
    if ($anti_replay = 425) { return 425; }

    include /etc/angie/conf.d/security-headers.inc;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include /etc/angie/conf.d/error-pages.inc;

    location = /uptime-kuma {
        return 301 /uptime-kuma/;
    }

    location ^~ /uptime-kuma/ {
        set $url_prefix uptime-kuma;

        rewrite ^/uptime-kuma/(.*)$ /$1 break;

        proxy_pass http://uptime_kuma_backend;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Early-Data $rfc_early_data;

        proxy_set_header Accept-Encoding "";

        proxy_redirect / /$url_prefix/;
        proxy_redirect http://$host/ https://$host/$url_prefix/;

        subs_filter_types *;

        subs_filter (['"])/(assets|socket\.io|icon\.svg|favicon\.ico|apple-touch-icon\.png|manifest\.json|serviceWorker\.js|api|upload|dashboard|settings|maintenance|add|add-status-page|manage-status-page|status)(['"/]) $1/$url_prefix/$2$3 ir;

        subs_filter (['"])assets/ $1$url_prefix/assets/ ir;

        subs_filter scope:\s*['"]/['"] scope:'/$url_prefix/' ir;

        access_log off;
    }
}
